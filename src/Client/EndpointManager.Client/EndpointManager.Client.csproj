    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EndpointManager.Client</RootNamespace>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
